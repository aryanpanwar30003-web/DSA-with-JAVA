
/*
 * Problem: Reverse String
 * LeetCode: 344
 * Pattern: Two Pointers
 * Difficulty: Easy
 *
 * Approach:
 * Use two pointers at opposite ends of the array.
 * Swap their characters and move both pointers inward.
 *
 * Time Complexity: O(n)
 * Space Complexity: O(1)
 */

class Solution {
    public void reverseString(char[] s) {
        int i = 0;
        int j = s.length - 1;

        while (i < j) {
            char temp = s[i];
            s[i] = s[j];
            s[j] = temp;

            i++;
            j--;
        }
    }
}
