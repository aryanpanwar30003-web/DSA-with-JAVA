
/*
 * Problem: Two Sum II - Input Array Is Sorted
 * LeetCode: 167
 * Difficulty: Medium
 * Pattern: Two Pointers
 *
 * Approach:
 * Use two pointers, one starting from the beginning
 * and the other from the end of the sorted array.
 *
 * Calculate the sum of the elements at both pointers.
 *
 * If the sum is smaller than the target, move the
 * left pointer forward to increase the sum.
 *
 * If the sum is greater than the target, move the
 * right pointer backward to decrease the sum.
 *
 * When the sum equals the target, return both indices.
 * Since the problem requires 1-based indexing, add 1
 * to both pointer positions.
 *
 * Time Complexity: O(n)
 * Space Complexity: O(1)
 */
class Solution {
    public int[] twoSum(int[] numbers, int target) {
        int i =0;
        int j=numbers.length-1;
        while(i<j){
            int sum = numbers[i] +numbers[j];
            if(sum<target) i++;
            else if (sum>target) j--;
            else return new int [] {i+1,j+1};

    }
    return new int[] {};
}
}
